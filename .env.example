# Timeout environment variables — copy to .env.local for dev, set in hosting (e.g. Vercel) for prod.
# Never commit a real .env file. .env* (other than this example) is gitignored.

# === Public (browser-readable) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App store / Capacitor
NEXT_PUBLIC_APP_NAME=Timeout
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SITE_URL=

# === Server-only (NEVER prefix with NEXT_PUBLIC_) ===
# Supabase service role (for admin ops, webhooks) — server routes only
SUPABASE_SERVICE_ROLE_KEY=

# Payment gateways — wire up only when Timeout needs them
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

YOCO_SECRET_KEY=
YOCO_PUBLIC_KEY=

OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_SANDBOX=true

# Couriers — wire up only when Timeout needs shipping
PARGO_API_KEY=
THE_COURIER_GUY_API_KEY=
DAWN_WING_API_KEY=

# Email (Resend) — wire up when Timeout sends transactional mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Analytics (PostHog) — wire up when ready
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Push notifications — wire up when ready
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
